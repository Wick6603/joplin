# =============================================================================
# Joplin Server —— linux/arm/v7 (armhf, 32-bit) 【交叉编译版】
#
# 与 Dockerfile.server.armv7 的区别：
#   Stage 2 也跑在 BUILDPLATFORM（arm64 原生），用 arm-linux-gnueabihf 交叉
#   工具链直接编译出 armv7 的 node_sqlite3.node，完全绕开 QEMU。
#
#   实测基准（QEMU 版）：sqlite3 编译约 12 分钟
#   交叉编译预期：1-3 分钟
#   全流程预期：~42 分钟 -> ~8 分钟
#
# 状态：交叉编译路径尚未实机验证。若失败，请回退用 Dockerfile.server.armv7。
# 两者产出等价，可随时切换。
# =============================================================================
# syntax=docker/dockerfile:1

ARG NODE_VERSION=22

# =============================================================================
# Stage 1 - tsc-builder（原生架构，与 QEMU 版完全一致）
# =============================================================================
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION} AS tsc-builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /build

COPY .yarn/releases ./.yarn/releases
COPY .yarn/patches  ./.yarn/patches
COPY .yarn/joplin-empty-package ./.yarn/joplin-empty-package
COPY package.json .
COPY .yarnrc.yml .
COPY yarn.lock .
COPY gulpfile.js .
COPY tsconfig.json .

COPY packages/turndown ./packages/turndown
COPY packages/turndown-plugin-gfm ./packages/turndown-plugin-gfm
COPY packages/fork-htmlparser2 ./packages/fork-htmlparser2
COPY packages/server/package*.json ./packages/server/
COPY packages/fork-sax ./packages/fork-sax
COPY packages/fork-uslug ./packages/fork-uslug
COPY packages/htmlpack ./packages/htmlpack
COPY packages/renderer ./packages/renderer
COPY packages/tools ./packages/tools
COPY packages/utils ./packages/utils
COPY packages/lib ./packages/lib
COPY packages/server ./packages/server

RUN sed --in-place '/onenote-converter/d' ./packages/lib/package.json

ENV BUILD_SEQUENCIAL=1

RUN --mount=type=cache,target=/build/.yarn/cache \
    --mount=type=cache,target=/build/.yarn/berry/cache \
    yarn config set cacheFolder /build/.yarn/cache \
    && yarn install --inline-builds

RUN find /build/node_modules /build/packages/*/node_modules \
        -name '*.node' -delete 2>/dev/null; \
    rm -rf /build/node_modules/@img \
           /build/node_modules/sharp \
           /build/packages/*/node_modules/@img \
           /build/packages/*/node_modules/sharp; \
    echo "=== 清理后剩余 .node 文件（应为空）==="; \
    find /build -name '*.node' | head; \
    echo "=== dist 产物 ==="; \
    ls -la /build/packages/server/dist/app.js

# =============================================================================
# Stage 2 - cross-builder（arm64 原生 + 交叉工具链）
#
# 注意这里是 BUILDPLATFORM 而不是 TARGETPLATFORM —— 这是本版的核心。
# =============================================================================
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION} AS native-builder

# gcc/g++-arm-linux-gnueabihf 会自动带上 libc6-dev-armhf-cross 和
# libstdc++-12-dev-armhf-cross（Debian bookworm 是 gcc 12），不需要
# dpkg --add-architecture。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf \
        python3 make file \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g node-gyp@11.5.0
ENV npm_config_node_gyp=/usr/local/lib/node_modules/node-gyp/bin/node-gyp.js

# 交叉编译环境变量
#   CC/CXX       -> 目标架构（armv7）编译器
#   CC_host/...  -> 构建过程中需要的 host 工具用本地编译器
#   npm_config_arch/target_arch -> 让 node-gyp 生成 arm 而非 arm64 的产物
#   node-gyp 下载的 node headers 是纯头文件，架构无关，无需额外处理
ENV CC=arm-linux-gnueabihf-gcc \
    CXX=arm-linux-gnueabihf-g++ \
    CC_host=gcc \
    CXX_host=g++ \
    npm_config_arch=arm \
    npm_config_target_arch=arm

RUN arm-linux-gnueabihf-gcc --version | head -1

WORKDIR /build
COPY --from=tsc-builder /build /build

# 只编译第一份 sqlite3，其余复制（server / lib / tools 下各有一份，源码相同）
RUN set -e; \
    FIRST=""; \
    for d in /build/node_modules/sqlite3 /build/packages/*/node_modules/sqlite3; do \
        if [ -d "$d" ] && [ -z "$FIRST" ]; then FIRST="$d"; fi; \
    done; \
    if [ -z "$FIRST" ]; then echo "!!! 没找到 sqlite3 目录，检查依赖树"; exit 1; fi; \
    echo ">>> 交叉编译 sqlite3（仅此一份）: $FIRST"; \
    cd "$FIRST" && npm rebuild --build-from-source; \
    NODE_BIN=$(find "$FIRST/lib/binding" -name 'node_sqlite3.node' | head -1); \
    if [ -z "$NODE_BIN" ]; then echo "!!! 编译未产出 node_sqlite3.node"; exit 1; fi; \
    REL=${NODE_BIN#"$FIRST/lib/binding/"}; \
    echo ">>> 产物相对路径: $REL"; \
    for d in /build/node_modules/sqlite3 /build/packages/*/node_modules/sqlite3; do \
        if [ -d "$d" ] && [ "$d" != "$FIRST" ]; then \
            echo ">>> 复用产物 -> $d"; \
            mkdir -p "$d/lib/binding/$(dirname "$REL")"; \
            cp "$NODE_BIN" "$d/lib/binding/$REL"; \
        fi; \
    done

# 校验：这一步尤其重要 —— 交叉编译最怕"静默编成了 host 架构"
RUN echo "--- 产物清单 ---" \
    && find /build -name 'node_sqlite3.node' -exec ls -la {} \; \
    && echo "--- ELF 架构校验（必须是 ARM / 32-bit，不能是 AArch64）---" \
    && for f in $(find /build -name 'node_sqlite3.node'); do file "$f"; done \
    && echo "--- 断言：不得出现 aarch64 ---" \
    && if find /build -name 'node_sqlite3.node' -exec file {} \; | grep -qi aarch64; then \
           echo "!!! 产物被编成了 aarch64，交叉编译配置有误"; exit 1; \
       fi; \
    echo "--- 数量校验 ---"; \
    N_BIN=$(find /build -name 'node_sqlite3.node' | wc -l); \
    N_DIR=$(ls -d /build/node_modules/sqlite3 /build/packages/*/node_modules/sqlite3 2>/dev/null | wc -l); \
    echo "产物 $N_BIN 个 / sqlite3 目录 $N_DIR 个"; \
    [ "$N_BIN" = "$N_DIR" ] || { echo "!!! 数量不匹配"; exit 1; }

# =============================================================================
# Stage 3 - 最终运行镜像（arm/v7）
# =============================================================================
FROM --platform=$TARGETPLATFORM node:${NODE_VERSION}-slim

ARG user=joplin

# tini 在 armv7 阶段自己装（cross-builder 是 arm64，它的 tini 拷过来跑不了）
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash $user

RUN npm i -g pm2@5.4.3 && mkdir -p /opt/pm2 && chown -R $user:$user /opt/pm2
ENV PM2_HOME=/opt/pm2

USER $user

COPY --chown=$user:$user --from=native-builder /build/packages      /home/$user/packages
COPY --chown=$user:$user --from=native-builder /build/node_modules  /home/$user/node_modules

RUN pm2 install https://registry.npmjs.org/pm2-logrotate/-/pm2-logrotate-3.0.0.tgz \
	&& pm2 set pm2-logrotate:max_size 100MB \
	&& pm2 set pm2-logrotate:retain 5 \
	&& pm2 set pm2-logrotate:compress true

ENV NODE_ENV=production
ENV RUNNING_IN_DOCKER=1
ENV NODE_OPTIONS=--max-old-space-size=768

EXPOSE 22300

WORKDIR /home/$user/packages/server

ENTRYPOINT ["tini", "--"]
CMD ["yarn", "start-prod"]

ARG BUILD_DATE
ARG REVISION
ARG VERSION
ARG SOURCE
LABEL org.opencontainers.image.created="$BUILD_DATE" \
      org.opencontainers.image.title="Joplin Server (armv7, cross-compiled)" \
      org.opencontainers.image.description="Docker image for Joplin Server - linux/arm/v7" \
      org.opencontainers.image.url="https://joplinapp.org/" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.source="$SOURCE" \
      org.opencontainers.image.version="$VERSION"
